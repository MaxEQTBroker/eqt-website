# ─────────────────────────────────────────────────────────────
# EQT marketing site — environment variables (copy to .env.local)
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://www.eqt.ae"

# WhatsApp lead capture (international format, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="971500000000"

# Contact
NEXT_PUBLIC_CONTACT_EMAIL="hello@eqt.ae"
NEXT_PUBLIC_CONTACT_PHONE="+971 4 000 0000"

# Regulatory (Dubai / RERA)
NEXT_PUBLIC_RERA_ORN="00000"          # Office Registration Number (ORN)
NEXT_PUBLIC_DED_LICENSE="000000"      # DED trade license

# ─── CRM data source (wired later — the lib/data seam reads these) ───
# When ready, point the repository at the CRM's public read-only views.
# CRM_API_URL="https://crm.eqt.ae/api"
# CRM_PUBLIC_LISTINGS_VIEW="public_listings"
# CRM_PUBLIC_SOLD_VIEW="public_sold"
# CRM_API_KEY=""

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=""
