# ─────────────────────────────────────────────────────────────
# EQT marketing site — environment variables (copy to .env.local)
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://www.eqt.ae"

# WhatsApp lead capture (international format, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="971500000000"

# Contact
NEXT_PUBLIC_CONTACT_EMAIL="hello@eqt.ae"
NEXT_PUBLIC_CONTACT_PHONE="+971 4 000 0000"

# Regulatory (Dubai / RERA)
NEXT_PUBLIC_RERA_ORN="00000"          # Office Registration Number (ORN)
NEXT_PUBLIC_DED_LICENSE="000000"      # DED trade license

# ─── CRM lead intake (app/api/lead forwards form submissions here) ───
# Set these in Vercel (server-side, NOT NEXT_PUBLIC). Until CRM_LEAD_WEBHOOK_URL
# is set, the form still works and falls back to WhatsApp (no lead lost).
# CRM_LEAD_WEBHOOK_URL="https://crm.eqt.ae/api/leads"   # endpoint that accepts an inbound lead (POST JSON)
# CRM_LEAD_API_KEY=""                                    # token/key, if the CRM needs auth
# CRM_LEAD_AUTH_HEADER="Authorization"                  # header to send the key in (default Authorization)
# CRM_LEAD_AUTH_SCHEME="Bearer"                          # value prefix (default "Bearer"; set "" for a raw key)

# ─── CRM data source (listings/sold, wired later — the lib/data seam reads these) ───
# When ready, point the repository at the CRM's public read-only views.
# CRM_API_URL="https://crm.eqt.ae/api"
# CRM_PUBLIC_LISTINGS_VIEW="public_listings"
# CRM_PUBLIC_SOLD_VIEW="public_sold"
# CRM_API_KEY=""

# Search Console verification (optional — paste the token from Google's
# "HTML tag" method; renders <meta name="google-site-verification" ...>)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=""
